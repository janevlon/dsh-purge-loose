{
  "name": "dsh-purge-loose",
  "version": "0.1.0",
  "description": "DeepSeek Harness 破甲（宽松版）. Forked from YuJunZhiXue/dsh-purge.",
  "author": "bamboostrip",
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-loose": "bin/dsh-purge-loose.js"
  },
  "files": [
    "lib",
    "bin",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs",
    "test": "node --test"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamboostrip/dsh-purge.git"
  },
  "homepage": "https://github.com/bamboostrip/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/bamboostrip/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/bamboostrip/dsh-purge/tar.gz/refs/heads/master",
      "zip": "https://codeload.github.com/bamboostrip/dsh-purge/zip/refs/heads/master",
      "git": "https://github.com/bamboostrip/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.0-rc.2"
}
